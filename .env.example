# ===================================================
# AMMAN DISTRIBUTORS — PRODUCTION ENVIRONMENT CONFIG
# ===================================================

# ---------------------------------------------------
# 1. RENDER (BACKEND ENVIRONMENT VARIABLES)
# ---------------------------------------------------
# Aiven MySQL connection string with SSL
# Format: mysql://avnadmin:<password>@<aiven-host>:<port>/defaultdb?ssl={"rejectUnauthorized":false}
DATABASE_URL=mysql://avnadmin:password@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl={"rejectUnauthorized":false}

# Allowed Vercel Frontend Domain (CORS restriction)
CLIENT_URL=https://amman-distributors.vercel.app

# Server Port (Render sets this dynamically)
PORT=10000
NODE_ENV=production

# ---------------------------------------------------
# 2. VERCEL (FRONTEND ENVIRONMENT VARIABLES)
# ---------------------------------------------------
# Points frontend React & PWA to the Render HTTPS backend URL
# NEVER expose DATABASE_URL or JWT secrets on Vercel
VITE_API_URL=https://amman-distributors-api.onrender.com
